# Copy to .env and set your own Canvas origin. No credentials are supplied.
CANVAS_BASE_URL=https://canvas.example.edu
READ_ONLY=true
# Docker Compose mounts these from .secrets/. Node also supports these paths.
MCP_URL_SECRET_FILE=.secrets/mcp_key
CANVAS_TOKEN_FILE=.secrets/canvas_token
# Alternatively set MCP_URL_SECRET and CANVAS_TOKEN in your private .env.
# MCP_URL_SECRET=
# CANVAS_TOKEN=
HOST=127.0.0.1
PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],canvas-mcp
# Requests without Origin are accepted. Browser origins require an explicit list.
ALLOWED_ORIGINS=
# Prefer Authorization: Bearer or X-MCP-Key. Enable only for URL-only clients.
MCP_ALLOW_QUERY_KEY=false
MAX_API_RESPONSE_BYTES=2000000
MAX_FILE_BYTES=10000000
MAX_TEXT_CHARS=200000
