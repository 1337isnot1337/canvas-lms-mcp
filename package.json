{
  "name": "canvas-lms-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Canvas LMS MCP server with authenticated Streamable HTTP and Docker secret files.",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run test && npm test --workspaces --if-present",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "dependencies": {
    "@canvas-lms-mcp/mcp-core": "file:packages/mcp-core",
    "@canvas-lms-mcp/mcp-http-node": "file:packages/mcp-http-node",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "jszip": "^3.10.1",
    "tsx": "^4.20.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/express": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/mcp-core",
    "packages/mcp-http-node",
    "relay"
  ]
}
